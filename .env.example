NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=https://keypath.netlify.app
MONGODB_URI=mongodb://127.0.0.1:27017/keypath
# Optional in development (an ephemeral secret is generated if omitted).
# Production requires a unique random secret of at least 32 characters.
JWT_SECRET=
COOKIE_SECURE=false
# Comma-separated HTTPS frontend origins allowed in production.
ALLOWED_ORIGINS=https://keypath.netlify.app
